// Your 10-character Apple Team ID, from developer.apple.com/account
// under Membership details. Needed for signing; harmless to commit.
TEAM_ID=79QCCKAH5P

PRODUCT_NAME=MachineCharades

// Matches the Android applicationId exactly, so the game has one identity
// across both stores. Like Play's applicationId, this CANNOT be changed once
// the app record exists in App Store Connect — the KMP template's default
// appended $(TEAM_ID) to dodge collisions during development, which would
// have shipped as com.machinecharades.MachineCharadesXXXXXXXXXX forever.
PRODUCT_BUNDLE_IDENTIFIER=com.techtush.machinecharades

// App Store Connect refuses a second upload carrying a build number it has
// already seen, so CURRENT_PROJECT_VERSION must rise on every upload — even
// when nothing else changed. Override without editing this file:
//   xcodebuild ... CURRENT_PROJECT_VERSION=2
// MARKETING_VERSION is the number humans see and only moves on a real release.
CURRENT_PROJECT_VERSION=3
MARKETING_VERSION=1.0

// Android shows "Machine Charades" via app_name; match it on the Home screen.
// CFBundleName stays MachineCharades — it has a 15-char practical limit.
INFOPLIST_KEY_CFBundleDisplayName=Machine Charades
