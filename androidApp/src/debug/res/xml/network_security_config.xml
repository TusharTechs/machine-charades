<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG ONLY. Lives in src/debug, so it is absent from every release build.

  On a network with a TLS-intercepting proxy, the emulator's trust store has
  no copy of the corporate CA, so every HTTPS call fails with "Trust anchor
  for certification path not found". That surfaces confusingly: OkHttp
  reports the last route it tried, so the visible error was an IPv6
  ConnectException while the real failure was a TLS handshake on IPv4.

  Trusting user-installed CAs in addition to the system anchors makes the
  emulator behave like the host, which already trusts the proxy. This used
  to bundle a specific corporate root as a raw resource, which both pinned
  the file to one employer's network and published their internal CA name in
  a public repository. Reading the user store instead works behind any proxy
  and needs nothing committed: install the root on the emulator
  (Settings > Security > Encryption & credentials > Install a certificate)
  or with `adb push` plus the same screen.

  Release builds never see this file, so nothing here weakens them, and on a
  normal network it is simply unnecessary.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </base-config>
</network-security-config>
